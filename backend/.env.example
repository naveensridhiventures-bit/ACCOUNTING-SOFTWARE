# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
# On Render, use the connection string from the database dashboard (add ?sslmode=require for external URLs)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acct_dev
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Used only by `npm run seed`
SEED_COMPANY_NAME=My Company
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=navumaimu
SEED_FY_START_MONTH=4
# Two-digit GST state code of your business (29 = Karnataka). Decides CGST+SGST vs IGST. Can also be set in the app under Company.
SEED_COMPANY_STATE_CODE=29
